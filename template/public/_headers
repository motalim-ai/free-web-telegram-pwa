/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'none'; form-action 'self'; object-src 'none'; manifest-src 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The service worker must always be re-checked, or phones keep running an old version.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
